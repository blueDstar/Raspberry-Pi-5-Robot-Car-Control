<?xml version="1.0"?>
<!--
  URDF/Xacro cho xe robot 4 bánh Yahboom (mô phỏng)
  
  KẾT CẤU:
    base_link (chassis)
    ├── wheel_fl_link  (trái trước  - Motor1 trong hệ thật)
    ├── wheel_rl_link  (trái sau    - Motor2 trong hệ thật)
    ├── wheel_fr_link  (phải trước  - Motor3 trong hệ thật)
    ├── wheel_rr_link  (phải sau    - Motor4 trong hệ thật)
    ├── imu_link       (IMU MPU6050)
    ├── camera_link    (Camera tùy chọn)
    └── laser_link     (RPLidar - để dự phòng)

  GAZEBO PLUGINS:
    1. libgazebo_ros_skid_steer_drive: Điều khiển 4 bánh độc lập
    2. libgazebo_ros_imu_sensor: IMU giả lập
-->
<robot name="yahboom_car" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================
       THAM SỐ KÍCH THƯỚC
       Dựa trên kích thước thực của Yahboom Raspberry Pi Car Series
       ============================================================ -->
  <xacro:property name="chassis_length" value="0.20"/>   <!-- 20cm -->
  <xacro:property name="chassis_width"  value="0.15"/>   <!-- 15cm -->
  <xacro:property name="chassis_height" value="0.05"/>   <!-- 5cm  -->
  <xacro:property name="chassis_mass"   value="1.0"/>    <!-- 1 kg -->

  <xacro:property name="wheel_radius"   value="0.033"/>  <!-- 3.3cm bán kính bánh -->
  <xacro:property name="wheel_width"    value="0.026"/>  <!-- 2.6cm độ dày bánh -->
  <xacro:property name="wheel_mass"     value="0.1"/>    <!-- 100g mỗi bánh -->

  <!-- Khoảng cách từ tâm chassis đến tâm bánh -->
  <xacro:property name="wheel_x_offset" value="0.075"/> <!-- tiến/lùi so với center -->
  <xacro:property name="wheel_y_offset" value="0.095"/> <!-- trái/phải so với center (A+B trong kinematics) -->
  <xacro:property name="wheel_z_offset" value="-0.015"/><!-- bánh thấp hơn chassis -->

  <!-- ============================================================
       MACRO TÍNH QUÁN TÍNH (Inertia)
       ============================================================ -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia  ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
              iyy="${m*(x*x+z*z)/12}" iyz="0"
              izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertia  ixx="${m*(3*r*r+h*h)/12}" ixy="0" ixz="0"
              iyy="${m*(3*r*r+h*h)/12}" iyz="0"
              izz="${m*r*r/2}"/>
  </xacro:macro>

  <!-- ============================================================
       MACRO BÁNH XE
       prefix: fl/fr/rl/rr
       x_sign: +1 (trước) / -1 (sau)
       y_sign: +1 (trái)  / -1 (phải)
       ============================================================ -->
  <xacro:macro name="wheel" params="prefix x_sign y_sign">
    <link name="wheel_${prefix}_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_color_${prefix}">
          <!-- Bánh trái: đen, bánh phải: xám đậm -->
          <xacro:if value="${y_sign > 0}">
            <color rgba="0.1 0.1 0.1 1.0"/>
          </xacro:if>
          <xacro:unless value="${y_sign > 0}">
            <color rgba="0.3 0.3 0.3 1.0"/>
          </xacro:unless>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <mass value="${wheel_mass}"/>
        <xacro:cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
      </inertial>
    </link>

    <joint name="wheel_${prefix}_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="wheel_${prefix}_link"/>
      <origin xyz="${x_sign * wheel_x_offset}
                   ${y_sign * wheel_y_offset}
                   ${wheel_z_offset}"
              rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <!-- Giới hạn moment để tránh Gazebo unstable -->
      <limit effort="10.0" velocity="20.0"/>
      <dynamics damping="0.02" friction="0.1"/>
    </joint>

    <!-- Gazebo friction material cho bánh -->
    <gazebo reference="wheel_${prefix}_link">
      <mu1>1.5</mu1>
      <mu2>0.8</mu2>
      <kp>1e6</kp>
      <kd>1.0</kd>
      <material>Gazebo/DarkGray</material>
    </gazebo>
  </xacro:macro>

  <!-- ============================================================
       BASE LINK (CHASSIS)
       ============================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="chassis_blue">
        <color rgba="0.2 0.4 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <xacro:box_inertia m="${chassis_mass}"
                          x="${chassis_length}"
                          y="${chassis_width}"
                          z="${chassis_height}"/>
    </inertial>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

  <!-- Base footprint (gốc tọa độ robot trên mặt đất) -->
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <origin xyz="0 0 ${chassis_height/2 + wheel_radius + wheel_z_offset}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       4 BÁNH XE
       Motor1 = FL (trái trước)   Motor2 = RL (trái sau)
       Motor3 = FR (phải trước)   Motor4 = RR (phải sau)
       ============================================================ -->
  <xacro:wheel prefix="fl" x_sign=" 1" y_sign=" 1"/>  <!-- Motor1: trái trước  -->
  <xacro:wheel prefix="rl" x_sign="-1" y_sign=" 1"/>  <!-- Motor2: trái sau    -->
  <xacro:wheel prefix="fr" x_sign=" 1" y_sign="-1"/>  <!-- Motor3: phải trước  -->
  <xacro:wheel prefix="rr" x_sign="-1" y_sign="-1"/>  <!-- Motor4: phải sau    -->

  <!-- ============================================================
       IMU LINK (MPU6050 trong hệ thật)
       ============================================================ -->
  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.02 0.02 0.005"/>
      </geometry>
      <material name="imu_green">
        <color rgba="0.0 0.8 0.0 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.005"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="0.0 0.0 ${chassis_height/2 + 0.005}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       LASER LINK (dự phòng cho RPLidar)
       ============================================================ -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.02" length="0.04"/>
      </geometry>
      <material name="laser_black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser_link"/>
    <origin xyz="0.08 0.0 ${chassis_height/2 + 0.025}" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================
       GAZEBO PLUGIN: SKID-STEER DRIVE (4 bánh độc lập)
       
       GIẢI THÍCH: Plugin này mô phỏng cách board control thật điều khiển
       4 motor độc lập. Plugin nhận /cmd_vel và tính tốc độ cho từng bánh
       tương tự kinematics: Vm_left = Vx - Vz*L, Vm_right = Vx + Vz*L
       
       TRONG HỆ THẬT: Board ESP32 firmware làm việc này bằng C++,
       rồi gửi PWM đến motor driver IC.
       ============================================================ -->
  <gazebo>
    <plugin name="yahboom_skid_steer_drive" filename="libgazebo_ros_skid_steer_drive.so">
      <!-- Namespace ROS 2 -->
      <ros>
        <namespace>/robot1</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=gazebo/odom</remapping>
      </ros>

      <!-- Tần số publish odometry từ Gazebo (ground truth) -->
      <update_rate>50</update_rate>

      <!-- Tên 4 bánh xe khớp với joint names ở trên -->
      <left_front_joint>wheel_fl_joint</left_front_joint>
      <left_rear_joint>wheel_rl_joint</left_rear_joint>
      <right_front_joint>wheel_fr_joint</right_front_joint>
      <right_rear_joint>wheel_rr_joint</right_rear_joint>

      <!-- Thông số xe - khớp với mock_client.py -->
      <wheel_separation>${2 * wheel_y_offset}</wheel_separation>
      <wheel_diameter>${2 * wheel_radius}</wheel_diameter>

      <!-- Publish odometry + TF từ Gazebo (ground truth, so sánh với /odom) -->
      <publish_odom>true</publish_odom>
      <publish_odom_tf>false</publish_odom_tf>  <!-- Driver tự publish TF -->
      <publish_wheel_tf>true</publish_wheel_tf>

      <!-- Frame names -->
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- ============================================================
       GAZEBO PLUGIN: IMU SENSOR
       
       TRONG HỆ THẬT: MPU6050 kết nối với ESP32 qua I2C,
       firmware đọc raw data và publish qua micro-ROS.
       ============================================================ -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>  <!-- 100Hz giống MPU6050 -->
      <visualize>false</visualize>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/robot1</namespace>
          <remapping>~/out:=imu/data_raw</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <!-- Gaussian noise mô phỏng nhiễu MPU6050 thật -->
        <gaussian_noise>0.01</gaussian_noise>
      </plugin>
    </sensor>

    <material>Gazebo/Green</material>
  </gazebo>

  <!-- ============================================================
       GAZEBO PLUGIN: JOINT STATE PUBLISHER
       Publish joint states (góc và vận tốc các bánh)
       ============================================================ -->
  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/robot1</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>50</update_rate>
      <joint_name>wheel_fl_joint</joint_name>
      <joint_name>wheel_rl_joint</joint_name>
      <joint_name>wheel_fr_joint</joint_name>
      <joint_name>wheel_rr_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
