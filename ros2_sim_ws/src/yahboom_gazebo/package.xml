<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yahboom_gazebo</name>
  <version>1.0.0</version>
  <description>
    Gazebo world và spawn robot cho dự án mô phỏng Yahboom.
    Cung cấp môi trường mô phỏng với mặt phẳng phẳng để xe di chuyển.
  </description>
  <maintainer email="student@example.com">Student</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>gazebo_ros</depend>
  <depend>gazebo_ros_pkgs</depend>
  <depend>yahboom_description</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
